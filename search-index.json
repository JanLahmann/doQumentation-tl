5":{"position":[[13,2]]},"8":{"position":[[29,2]]},"10":{"position":[[20,2]]}}}],["nilal",{"_index":11,"t":{"8":{"position":[[19,9]]}}}],["open",{"_index":9,"t":{"8":{"position":[[4,4]]}}}],["pa",{"_index":22,"t":{"12":{"position":[[27,2]]}}}],["pagpapatakb",{"_index":1,"t":{"5":{"position":[[0,12]]}}}],["pagsisimul",{"_index":0,"t":{"3":{"position":[[0,11]]}}}],["proyektong",{"_index":16,"t":{"10":{"position":[[23,10]]}}}],["quantum",{"_index":13,"t":{"8":{"position":[[36,7]]}}}],["sourc",{"_index":10,"t":{"8":{"position":[[9,6]]}}}],["tungkol",{"_index":4,"t":{"7":{"position":[[0,7]]}}}]],"pipeline":["stemmer","stemmer-de","stemmer-es","stemmer-fr","stemmer-it","stemmer-pt","stemmer-jp","stemmer-ar","stemmer-he","stemmer-ko"]}},{"documents":[{"i":1,"t":"Open-source na frontend para sa mga tutorial, kurso, at dokumentasyon ng IBM Quantum — na may live, in-browser na pagpapatakbo ng code.","s":"doQumentation","u":"/","p":1}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/1",[0,0.288,1,0.288,2,0.288,3,0.288,4,0.288,5,0.288,6,0.288,7,0.396,8,0.288,9,0.288,10,0.288,11,0.288,12,0.288,13,0.288,14,0.288]]],"invertedIndex":[["brow",{"_index":12,"t":{"1":{"position":[[103,7]]}}}],["code.",{"_index":14,"t":{"1":{"position":[[130,5]]}}}],["dokumentasyon",{"_index":6,"t":{"1":{"position":[[56,13]]}}}],["frontend",{"_index":2,"t":{"1":{"position":[[15,8]]}}}],["ibm",{"_index":8,"t":{"1":{"position":[[73,3]]}}}],["kurso,",{"_index":5,"t":{"1":{"position":[[46,6]]}}}],["live,",{"_index":11,"t":{"1":{"position":[[94,5]]}}}],["mga",{"_index":3,"t":{"1":{"position":[[32,3]]}}}],["ng",{"_index":7,"t":{"1":{"position":[[70,2],[127,2]]}}}],["open",{"_index":0,"t":{"1":{"position":[[0,4]]}}}],["pagpapatakb",{"_index":13,"t":{"1":{"position":[[114,12]]}}}],["quantum",{"_index":9,"t":{"1":{"position":[[77,7]]}}}],["sourc",{"_index":1,"t":{"1":{"position":[[5,6]]}}}],["tutorial,",{"_index":4,"t":{"1":{"position":[[36,9]]}}}],["—",{"_index":10,"t":{"1":{"position":[[85,1]]}}}]],"pipeline":["stemmer","stemmer-de","stemmer-es","stemmer-fr","stemmer-it","stemmer-pt","stemmer-jp","stemmer-ar","stemmer-he","stemmer-ko"]}},{"documents":[],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[],"invertedIndex":[],"pipeline":["stemmer","stemmer-de","stemmer-es","stemmer-fr","stemmer-it","stemmer-pt","stemmer-jp","stemmer-ar","stemmer-he","stemmer-ko"]}},{"documents":[{"i":2,"t":"Matuto ng quantum computing gamit ang mga tutorial at kurso ng Qiskit ng IBM, at patakbuhin ang code dito mismo sa browser mo. Walang install, at hindi kailangan ng account para magsimula. Patakbuhin ang una mong quantum CircuitTingnan ang katalogo ng mga kurso 42Mga Tutorial 171Mga Gabay 154Mga pahina ng kurso 14Mga Modyul","s":"doQumentation","u":"/","h":"","p":1},{"i":4,"t":"Bago sa quantum computing? Magsimula sa kurso. Pamilyar na ba sa Qiskit? Tumalon na sa isang tutorial o gabay. Hindi kailangan ng IBM Quantum account. Pinapatakbo ang code sa built-in na simulator bilang default. Idagdag ang iyong API key sa Settings kung gusto mo lang gumamit ng totoong quantum hardware. KursoBasics of Quantum InformationMagsimula dito — nakaayos na kurso mula sa single systems hanggang entanglementTutorialHello World: Ang Iyong Unang Quantum CircuitSariling intro ng doQumentation — bumuo ng Bell state, patakbuhin sa tatlong paraanGabayConstruct circuitsGabay ng IBM sa pagbuo ng mga quantum circuit sa QiskitTutorialCHSH InequalityMagpatakbo ng Bell test sa isang quantum computerTutorialGrover's algorithmMaghanap nang mas mabilis sa isang unstructured na listahan gamit ang amplitude amplification","s":"Pagsisimula","u":"/","h":"#getting-started","p":1},{"i":6,"t":"Mag-click ng Run sa kahit anong code block. Ang unang click ay magsisimula ng Jupyter kernel sa pamamagitan ng Binder o IBM Code Engine. Pagkatapos noon, instant na ang mga pagpapatakbo. Simulator Mode (hindi kailangan ng account) — Naka-on bilang default: pinapatakbo ang code sa AerSimulator o sa mga noise-model FakeBackends na maaari mong piliin sa Settings. Sinasabi ng mga pahinang nangangailangan ng IBM Quantum hardware o ng cloud services ng IBM kapag pinatakbo mo ang mga ito. IBM Quantum Hardware — Ilagay ang iyong API token at CRN sa Settings nang isang beses lamang — ang mga credentials ay awtomatikong ini-inject sa bawat pagpapatakbo. Gumawa ng libreng account kung wala ka pang account. Available na mga execution backend Bawat tutorial ay may mga executable code blocks. Mag-click ng Run upang magpatakbo gamit ang isa sa apat na backend: Binder (default sa GitHub Pages) — Libreng remote Jupyter kernel sa pamamagitan ng mybinder.org IBM Code Engine — Serverless Jupyter sa iyong IBM Cloud account. Cold start sa loob ng ilang segundo sa halip na minuto. I-set up Local Jupyter (Docker / RasQberry) — Kumokonekta sa lokal na Jupyter server na may pre-installed na Qiskit Custom server — Ituro sa kahit anong Jupyter endpoint sa Settings Kapag may maraming backend na available, piliin kung alin ang gagamitin mula sa Settings. Mga opsyon sa deployment Ang doQumentation ay available bilang: GitHub Pages — Static site na may Binder o IBM Code Engine para sa remote code execution Docker — Kumpletong stack sa lokal, maaaring mag-offline RasQberry — Self-hosted sa Raspberry Pi na may lokal na Jupyter kernel Magpatakbo nang lokal gamit ang Podman / Docker Mag-install ng Podman Desktop o Docker Desktop (Mac / Windows / Linux), pagkatapos ay magpatakbo ng: # Full stack: site + Jupyter + Qiskit (~3 GB) podman run -p 8080:80 -p 8888:8888 ghcr.io/janlahmann/doqumentation:jupyter Buksan ang http://localhost:8080 — gumagana ang code execution nang lokal, walang paghihintay sa Binder. Gumagamit ng Docker? Palitan lamang ang podman ng docker — pareho ang mga command. Ang mga image ay multi-arch (linux/amd64 + linux/arm64), kaya gumagana nang native (walang emulation) ang Apple Silicon Macs.","s":"Pagpapatakbo ng code","u":"/","h":"#code-execution","p":1},{"i":9,"t":"Nagbibigay ang IBM ng napakaraming quantum computing na materyales sa pag-aaral — lahat ay open source sa ilalim ng CC BY-SA 4.0: Learning — Mga nakaayos na kurso mula sa mga basic ng quantum hanggang sa mga advanced na paksa Tutorials — 40+ na mga tutorial tungkol sa transpilation, error mitigation, at iba pa Documentation — Mga gabay at API reference para sa Qiskit Source repo — Lahat ng nilalaman sa GitHub Ang kanilang Quantum Platform ay palaging napapanahon at magandang-disenyo — ang pinakamahusay na lugar para sa pagbabasa, pag-aaral, at reference.","s":"Ang open-source na nilalaman ng IBM Quantum","u":"/","h":"#ibm-quantums-open-source-content","p":1},{"i":11,"t":"Ang Qiskit documentation ng IBM ay open source (CC BY-SA 4.0), ngunit ang kanilang web application ay hindi. Ang doQumentation ay nagdadagdag ng open-source na frontend na may live code execution, awtomatikong credential injection, at simulator mode. Pwedeng i-deploy kahit saan — mula sa GitHub Pages hanggang sa Docker hanggang sa RasQberry. Tingnan ang lahat ng features.","s":"Ano ang idinadagdag ng proyektong ito","u":"/","h":"#what-this-project-adds","p":1},{"i":13,"t":"Tinutulungan ka ng doQumentation na gawin ang iyong unang mga hakbang sa Qiskit — magbasa, magpatakbo ng code, at mag-explore — nang hindi kailangang mag-install ng anuman. Habang ikaw ay umuusad, pumunta sa opisyal na platform ng IBM: Patakbuhin sa tunay na hardware — gumawa ng libreng IBM Cloud account at isang Open Plan instance para magpatakbo ng mga circuit sa tunay na quantum computers. Pinakabagong nilalaman — ang Qiskit learning platform ng IBM ay may pinakabagong mga kurso, tutorial, at karagdagan (maaaring may ilan na wala pa sa doQumentation). Mag-develop nang lokal — i-install ang Qiskit sa sarili mong laptop para sa seryosong gawaing development. Itinayo gamit ang open-source na dokumentasyon ng IBM Quantum. Salamat sa pangkat ng IBM Quantum sa paggawa nitong nilalaman na malayang available sa ilalim ng CC BY-SA 4.0.","s":"Kapag handa ka na sa higit pa","u":"/","h":"#when-youre-ready-for-more","p":1}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/2",[0,2.035,1,0.147,2,0.398,3,1.36,4,0.584,5,0.14,6,0.398,7,0.729,8,1.248,9,0.319,10,2.035,11,1.144,12,0.584,13,1.36,14,2.035,15,2.035,16,2.035,17,1.36,18,2.035,19,0.916,20,0.916,21,0.916,22,2.035,23,0.916,24,2.035,25,2.035,26,2.035,27,2.035,28,1.36,29,2.035,30,2.035,31,2.035,32,2.035]],["t/4",[1,0.142,2,0.462,4,0.477,5,0.129,6,0.26,7,0.477,8,0.748,11,0.748,12,0.477,13,1.111,19,0.748,20,0.748,33,1.663,34,1.663,35,1.663,36,1.663,37,1.663,38,1.663,39,1.663,40,1.663,41,1.133,42,1.663,43,0.349,44,1.111,45,1.111,46,1.663,47,0.748,48,1.111,49,1.663,50,1.663,51,1.004,52,0.748,53,1.663,54,1.111,55,1.111,56,1.663,57,1.111,58,1.663,59,1.663,60,1.663,61,1.663,62,1.663,63,1.663,64,0.349,65,1.111,66,0.477,67,1.663,68,1.663,69,0.748,70,1.663,71,1.663,72,0.748,73,1.663,74,1.663,75,0.477,76,1.663,77,2.231,78,1.663,79,1.663,80,1.663,81,1.663,82,1.663,83,1.111,84,1.663,85,1.663,86,1.663,87,1.663,88,1.663,89,0.748,90,1.663,91,1.663,92,1.663,93,1.663,94,1.663]],["t/6",[1,0.138,2,0.224,4,0.409,5,0.139,6,0.416,7,0.259,9,0.224,12,0.724,17,0.604,20,0.407,21,0.407,23,0.407,41,0.407,43,0.381,44,0.954,45,0.604,47,0.407,48,0.604,51,0.642,52,0.407,54,1.182,55,0.954,57,0.604,64,0.432,66,0.259,72,0.407,75,0.259,89,0.904,95,1.343,96,1.769,97,1.769,98,0.954,99,1.428,100,0.904,101,0.667,102,0.904,103,2.523,104,1.769,105,1.428,106,1.769,107,0.904,108,1.428,109,0.904,110,0.904,111,1.428,112,0.904,113,0.904,114,0.904,115,0.904,116,0.904,117,0.904,118,0.904,119,0.904,120,0.904,121,0.904,122,1.428,123,1.428,124,0.904,125,0.904,126,0.904,127,0.954,128,0.954,129,0.904,130,1.428,131,0.904,132,0.904,133,0.904,134,0.904,135,0.904,136,0.904,137,1.428,138,0.604,139,0.604,140,0.904,141,0.904,142,1.428,143,0.604,144,0.954,145,0.604,146,0.604,147,0.904,148,0.954,149,2.009,150,1.428,151,0.904,152,0.904,153,1.182,154,0.904,155,0.904,156,0.904,157,0.904,158,0.642,159,0.904,160,1.428,161,0.904,162,1